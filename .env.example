# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# Database (Supabase / Render Postgres connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/one_place

# Firebase Admin SDK
# Path to the downloaded service account JSON (do NOT commit this file)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Brevo — leave blank for now; EmailService only logs until this is set
# and app/services/email.py is wired to a real Brevo API call
BREVO_API_KEY=

# reCAPTCHA secret key — gates POST /api/subscriptions so it can't be
# scripted easily. Get this from https://www.google.com/recaptcha/admin.
# Leave blank in local dev and verification fails closed (rejects every
# subscription) rather than silently passing — set SKIP_RECAPTCHA in
# your test config instead of leaving this blank if you need to test
# the subscription flow without a real key.
RECAPTCHA_SECRET_KEY=

# There is no env var for bootstrapping the first superadmin — run
# `flask bootstrap-superadmin --email you@example.com --password ...`
# once, from a trusted shell, after the database exists. See README.
